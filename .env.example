# ─── Aviraa Environment Configuration ─────────────────────────────

# MongoDB root credentials (used by docker-compose mongodb service)
MONGO_ROOT_USER=aviraa_root
MONGO_ROOT_PASSWORD=AviraaRoot2024!

# MongoDB application user (used for backend connection)
MONGO_USER=aviraa_user
MONGO_PASSWORD=AviraaUser2024!

# JWT Secret - CHANGE THIS in production!
JWT_SECRET=aviraa_super_secret_key_change_me_2024
JWT_EXPIRE=30d

# Node environment
NODE_ENV=production

# Backend port
PORT=5000

# Client URL (CORS origin in dev)
CLIENT_URL=http://localhost:8080

# ─── LLM API (OpenAI-compatible) ──────────────────────────────────
# Leave OPENAI_API_KEY empty to use the built-in offline ML engine.
# Set it to enable real LLM responses for the AI Companion.
# Works with OpenAI, Groq, Together, OpenRouter, or any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Email (optional - for future notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password