# =============================================================================
# Vitta – medical-bill-backend configuration
# =============================================================================

# Database (SQLite is zero-setup for local development)
DATABASE_URL=sqlite+aiosqlite:///./medical_bills.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medical_bills

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
# S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=medical-bills

ENVIRONMENT=development

# Pipeline
PIPELINE_DELAY_SECONDS=3.0

# -----------------------------------------------------------------------------
# Rust Rules Engine (deterministic correctness)
# -----------------------------------------------------------------------------
RULES_ENGINE_URL=http://localhost:3001
RULES_ENGINE_TIMEOUT_SECONDS=5.0
RULES_ENGINE_ENABLED=true

# -----------------------------------------------------------------------------
# Member 2 – Extraction + XGBoost Scoring service
# -----------------------------------------------------------------------------
EXTRACTION_SERVICE_URL=http://localhost:8001
EXTRACTION_SERVICE_TIMEOUT_SECONDS=30.0
# For local demos, prefer true so the real Member 2 pipeline is exercised.
# When false, the backend uses the high-quality mock data generator.
EXTRACTION_SERVICE_ENABLED=true
# When true, extraction failures raise instead of falling back to mock.
# Only safe in production when Member 2 is guaranteed available.
EXTRACTION_STRICT_MODE=false

# -----------------------------------------------------------------------------
# Document text extraction / OCR
# -----------------------------------------------------------------------------
# PDFs: embedded text is always extracted via pypdf (no config needed).
# Images / scanned PDFs: requires an OCR provider (pytesseract + tesseract
# binary). Set OCR_ENABLED=true only when one is installed and on PATH;
# otherwise image/scanned uploads fail with a clear, honest error.
OCR_ENABLED=false

# -----------------------------------------------------------------------------
# LLM / Grounded Letter Generation
# -----------------------------------------------------------------------------
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# Auth — opaque, revocable bearer tokens
# -----------------------------------------------------------------------------
# All protected routes are authenticated via opaque session tokens issued by
# POST /api/v1/auth/register and /login. Only the SHA-256 of a token is stored;
# tokens expire after AUTH_TOKEN_TTL_HOURS and are revoked by /logout or
# /logout-everywhere. There is intentionally NO static token or global "disable
# auth" toggle — enforcement is always on.
AUTH_TOKEN_TTL_HOURS=24
UPLOAD_RATE_LIMIT_PER_MINUTE=20
# Whether a freshly-registered account must confirm its email before logging in.
# Flip to true (and wire a real email sender) before handling real patient data.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TTL_HOURS=24
# Explicit CORS allowlist (comma-separated). Never use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# -----------------------------------------------------------------------------
# Letter citation policy (fabrication guard)
# -----------------------------------------------------------------------------
# "off" -> no citation check; "warn" -> any legal/regulatory citation not in
# ALLOWED_CITATIONS fails letter verification. Comma-separated approved list.
CITATION_FABRICATION_POLICY=off
ALLOWED_CITATIONS=
