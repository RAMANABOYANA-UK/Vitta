# =============================================================================
# Vitta – medical-bill-backend configuration
# =============================================================================

# Database (SQLite is zero-setup for local development)
DATABASE_URL=sqlite+aiosqlite:///./medical_bills.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medical_bills

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
# S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=medical-bills

ENVIRONMENT=development

# Pipeline
PIPELINE_DELAY_SECONDS=3.0
MOCK_PIPELINE=true

# -----------------------------------------------------------------------------
# Rust Rules Engine (deterministic correctness)
# -----------------------------------------------------------------------------
RULES_ENGINE_URL=http://localhost:3001
RULES_ENGINE_TIMEOUT_SECONDS=5.0
RULES_ENGINE_ENABLED=true

# -----------------------------------------------------------------------------
# Member 2 – Extraction + XGBoost Scoring service
# -----------------------------------------------------------------------------
EXTRACTION_SERVICE_URL=http://localhost:8001
EXTRACTION_SERVICE_TIMEOUT_SECONDS=30.0
EXTRACTION_SERVICE_ENABLED=false

# -----------------------------------------------------------------------------
# LLM / Grounded Letter Generation
# -----------------------------------------------------------------------------
LLM_ENABLED=true
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1