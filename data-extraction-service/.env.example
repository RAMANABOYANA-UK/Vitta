# --- Service identity ---
APP_NAME=medbills-data-extraction
ENVIRONMENT=development

# --- LLM extraction (Instructor + OpenAI-compatible) ---
# Set OPENAI_API_KEY to enable LLM-based extraction. If unset, the service
# falls back to the offline heuristic parser.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0

# --- Extraction thresholds ---
LOW_CONFIDENCE_THRESHOLD=0.6
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# --- Validation ---
REFERENCE_DATA_DIR=data/reference
AMOUNT_TOLERANCE=0.01

# --- ML models ---
MODELS_DIR=models
ANOMALY_THRESHOLD=0.7
APPEAL_THRESHOLD_STRONG=0.7
APPEAL_THRESHOLD_MODERATE=0.5

# --- Database (Neon/Supabase-compatible PostgreSQL) ---
# Leave unset to disable persistence (service still works, just doesn't save).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Synthetic data generation ---
SYNTHETIC_SEED=42
SYNTHETIC_N_SAMPLES=20000